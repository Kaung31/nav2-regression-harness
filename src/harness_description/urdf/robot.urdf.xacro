<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="harness_bot">

  <xacro:property name="chassis_x" value="0.35"/>
  <xacro:property name="chassis_y" value="0.25"/>
  <xacro:property name="chassis_z" value="0.10"/>
  <xacro:property name="chassis_m" value="5.0"/>
  <xacro:property name="wheel_r"   value="0.05"/>
  <xacro:property name="wheel_w"   value="0.04"/>
  <xacro:property name="wheel_m"   value="0.5"/>
  <xacro:property name="wheel_sep" value="0.26"/>
  <xacro:property name="caster_r"  value="0.03"/>
  <xacro:property name="caster_m"  value="0.2"/>

  <material name="grey"><color rgba="0.4 0.4 0.45 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="red"><color rgba="0.7 0.1 0.1 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.08"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_m}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
  </link>

  <xacro:macro name="wheel" params="prefix y_sign">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${prefix}_wheel"/>
      <origin xyz="-0.05 ${y_sign*wheel_sep/2} -0.03" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_m}"/>
        <inertia ixx="${wheel_m*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}" ixy="0" ixz="0"
                 iyy="${wheel_m*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}" iyz="0"
                 izz="${wheel_m*wheel_r*wheel_r/2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_sign="1"/>
  <xacro:wheel prefix="right" y_sign="-1"/>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="0.13 0 -0.05"/>
  </joint>

  <link name="caster">
    <visual>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision><geometry><sphere radius="${caster_r}"/></geometry></collision>
    <inertial>
      <mass value="${caster_m}"/>
      <inertia ixx="${2*caster_m*caster_r*caster_r/5}" ixy="0" ixz="0"
               iyy="${2*caster_m*caster_r*caster_r/5}" iyz="0"
               izz="${2*caster_m*caster_r*caster_r/5}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.10 0 0.075"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="red"/>
    </visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <xacro:box_inertia m="0.15" x="0.05" y="0.05" z="0.05"/>
  </link>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="caster">
    <mu1>0.001</mu1><mu2>0.001</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>